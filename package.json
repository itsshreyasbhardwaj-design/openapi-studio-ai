{
  "name": "openapi-studio-ai",
  "version": "0.1.0",
  "private": false,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "screenshots": "tsx scripts/screenshots.mts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.22",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.64.0",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.57.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "description": "An open-source AI-powered API design, testing, documentation and monitoring platform for OpenAPI 3.x and GraphQL.",
  "license": "MIT",
  "keywords": [
    "openapi",
    "swagger",
    "api-design",
    "sdk-generator",
    "mock-server",
    "api-testing",
    "api-documentation",
    "graphql",
    "nextjs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/itsshreyasbhardwaj-design/openapi-studio-ai.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.17.0"
}
