# ---------------------------------------------------------------------------
# OpenAPI Studio AI — environment configuration
#
# Every value below is OPTIONAL. With an empty .env the platform boots in
# "local mode": an on-disk repository under .data/, a local single-user
# session, and a deterministic offline AI engine. Add keys to progressively
# light up hosted capabilities.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Public origin of the deployment; used for docs links and mock server URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# "local" (default) | "production"
APP_MODE=local
# 32+ char secret used to encrypt stored credentials (environment secrets,
# provider keys). Generate with: openssl rand -base64 48
ENCRYPTION_KEY=

# --- Persistence ------------------------------------------------------------
# Supabase / any PostgreSQL connection string. When unset, the file-backed
# repository under .data/ is used instead.
DATABASE_URL=

# --- Authentication (Clerk) -------------------------------------------------
# When both keys are present Clerk is enabled and routes are protected.
# When absent the app runs with a local development identity.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- AI (OpenRouter) --------------------------------------------------------
# When absent, the deterministic offline spec generator is used so the product
# is fully functional (and free) without any provider account.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Limits -----------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
MAX_SPEC_BYTES=2000000
